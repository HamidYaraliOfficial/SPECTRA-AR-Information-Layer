    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to SPECTRA</string>
    <string name="onboarding_welcome_body">Point your camera at the world. SPECTRA layers live information — text, objects, places, and your own notes — directly onto what you see.</string>
    <string name="onboarding_privacy_title">Your data stays on your device</string>
    <string name="onboarding_privacy_body">Camera frames, OCR, and object detection run on-device by default. Nothing is sent to the cloud unless you explicitly turn it on.</string>
    <string name="onboarding_permissions_title">Permissions, explained up front</string>
    <string name="onboarding_permissions_body">SPECTRA only asks for what a feature needs, when you use that feature. You can review or revoke everything from the Privacy Center at any time.</string>
